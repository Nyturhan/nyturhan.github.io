---
import { work } from "../content/site";
---

<section class="section" id="work" aria-labelledby="work-title">
  <div class="wrap">
    <p class="section__label">Experience</p>
    <h2 class="section__title is-reveal" id="work-title">Work</h2>
    <ol class="timeline">
      {
        work.map((entry) => (
          <li class="timeline__item">
            <div class="timeline__meta">
              <time class="timeline__date">{entry.date}</time>
              {entry.logo && (
                <img
                  class="timeline__logo"
                  src={entry.logo}
                  alt=""
                  width="40"
                  height="40"
                  loading="lazy"
                />
              )}
            </div>
            <div class="timeline__body">
              <h3 class="timeline__role">{entry.role}</h3>
              <p class="timeline__company">
                {entry.companyUrl ? (
                  <a href={entry.companyUrl} target="_blank" rel="noopener noreferrer">
                    {entry.company}
                  </a>
                ) : (
                  entry.company
                )}
              </p>
              <p class="timeline__summary">{entry.summary}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2.5rem;
  }

  .timeline__item {
    display: grid;
    grid-template-columns: minmax(10rem, 14rem) 1fr;
    gap: 1.5rem 2rem;
    align-items: start;
  }

  .timeline__meta {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .timeline__date {
    font-family: var(--font-ui);
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--umber);
  }

  .timeline__logo {
    width: 2.5rem;
    height: 2.5rem;
    object-fit: contain;
    border-radius: 4px;
    background: var(--chalk);
    padding: 0.2rem;
  }

  .timeline__role {
    font-family: var(--font-display);
    font-size: 1.55rem;
    font-weight: 500;
    margin: 0 0 0.25rem;
    letter-spacing: -0.02em;
  }

  .timeline__company {
    font-family: var(--font-ui);
    font-size: 0.95rem;
    font-weight: 600;
    margin: 0 0 0.75rem;
    color: var(--ink-muted);
  }

  .timeline__company a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }

  .timeline__company a:hover {
    color: var(--ink-blue);
    border-bottom-color: currentColor;
  }

  .timeline__summary {
    margin: 0;
    max-width: 52ch;
    color: var(--ink-muted);
  }

  @media (max-width: 720px) {
    .timeline__item {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }

    .timeline__meta {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }
</style>
