---
import { site } from "../content/site";
---

<section class="section" id="contact" aria-labelledby="contact-title">
  <div class="wrap">
    <p class="section__label">Say hello</p>
    <h2 class="section__title is-reveal" id="contact-title">Contact</h2>
    <p class="contact__lead">
      Want to talk about a project, a product, or just say hi? My inbox is open.
      I’m not currently looking for new roles.
    </p>
    <a class="contact__email" href={`mailto:${site.email}`}>{site.email}</a>
    <ul class="contact__social">
      {
        site.social.map((item) => (
          <li>
            <a
              href={item.href}
              target={item.href.startsWith("mailto:") ? undefined : "_blank"}
              rel={item.href.startsWith("mailto:") ? undefined : "noopener noreferrer"}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .contact__lead {
    margin: 0 0 1.5rem;
    max-width: 36ch;
    color: var(--ink-muted);
  }

  .contact__email {
    display: inline-block;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 1.2rem + 1.5vw, 2.2rem);
    font-weight: 500;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--ink);
    margin-bottom: 1.75rem;
  }

  .contact__email:hover {
    color: var(--ink-blue);
    border-bottom-color: var(--ink-blue);
  }

  .contact__social {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
  }

  .contact__social a {
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    color: var(--ink-muted);
  }

  .contact__social a:hover {
    color: var(--ink-blue);
  }
</style>
