---
import { education, achievements } from "../content/site";
---

<section class="section" id="background" aria-labelledby="background-title">
  <div class="wrap">
    <p class="section__label">Path</p>
    <h2 class="section__title is-reveal" id="background-title">Background</h2>

    <div class="edu">
      <img
        class="edu__logo"
        src={education.logo}
        alt=""
        width="56"
        height="56"
        loading="lazy"
      />
      <div>
        <h3 class="edu__school">{education.school}</h3>
        <p class="edu__degree">{education.degree}</p>
        <p class="edu__date">{education.date}</p>
        <p class="edu__note">{education.note}</p>
      </div>
    </div>

    <h3 class="achievements__heading">Competitive programming</h3>
    <ul class="achievements">
      {
        achievements.map((item) => (
          <li class="achievements__item">
            <img
              class="achievements__logo"
              src={item.logo}
              alt=""
              width="36"
              height="36"
              loading="lazy"
            />
            <div>
              <p class="achievements__title">{item.title}</p>
              <p class="achievements__detail">{item.detail}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .edu {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.25rem 1.5rem;
    margin-bottom: 3rem;
    max-width: 52rem;
  }

  .edu__logo {
    width: 3.5rem;
    height: 3.5rem;
    object-fit: contain;
    background: var(--chalk);
    border-radius: 4px;
    padding: 0.25rem;
  }

  .edu__school {
    font-family: var(--font-display);
    font-size: 1.55rem;
    font-weight: 500;
    margin: 0 0 0.25rem;
    letter-spacing: -0.02em;
  }

  .edu__degree {
    margin: 0;
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 0.95rem;
  }

  .edu__date {
    margin: 0.35rem 0 0.75rem;
    font-family: var(--font-ui);
    font-size: 0.9rem;
    color: var(--umber);
  }

  .edu__note {
    margin: 0;
    color: var(--ink-muted);
    max-width: 48ch;
  }

  .achievements__heading {
    font-family: var(--font-ui);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--umber);
    margin: 0 0 1.25rem;
  }

  .achievements {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
  }

  .achievements__item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.9rem;
    align-items: start;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--rule);
  }

  .achievements__logo {
    width: 2.25rem;
    height: 2.25rem;
    object-fit: contain;
    background: var(--chalk);
    border-radius: 4px;
    padding: 0.15rem;
  }

  .achievements__title {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 500;
    margin: 0 0 0.25rem;
  }

  .achievements__detail {
    margin: 0;
    color: var(--ink-muted);
    font-size: 0.98rem;
  }
</style>
